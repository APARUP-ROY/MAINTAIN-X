# Set these in the API server environment; never commit actual credentials.
MAINTAINX_PORT=8000
MAINTAINX_INGEST_TOKEN=replace-with-a-long-random-secret
MAINTAINX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAINTAINX_LIVE_DB=maintain_x/live.db
MAINTAINX_SIMULATION_ENABLED=1
MAINTAINX_SIMULATION_SEED=42
MAINTAINX_STALE_SECONDS=10

# Optional assistant. Configure only after rotating the exposed key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional MQTT. TLS port 8883 is the default; no broker is connected by default.
MQTT_BROKER_HOST=
MQTT_BROKER_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=maintain-x-dashboard
MQTT_TOPIC=maintain-x/+/readings
MQTT_TLS=1